{
  "name": "tiny-edit",
  "productName": "Tiny Edit",
  "version": "0.3.1",
  "description": "A small, fast Markdown and plain-text editor. Highlights, never reformats.",
  "private": true,
  "license": "MIT",
  "author": "Oskar Bruening",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --mac",
    "lint": "eslint .",
    "typecheck": "tsc -b tsconfig.node.json tsconfig.web.json tsconfig.e2e.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test:coverage && npm run test:e2e",
    "install:app": "npm run package && sudo rm -rf \"/Applications/Tiny Edit.app\" && sudo ditto \"dist/mac-arm64/Tiny Edit.app\" \"/Applications/Tiny Edit.app\"",
    "install:app:user": "npm run package && rm -rf \"$HOME/Applications/Tiny Edit.app\" && mkdir -p \"$HOME/Applications\" && ditto \"dist/mac-arm64/Tiny Edit.app\" \"$HOME/Applications/Tiny Edit.app\"",
    "install:cli": "node scripts/install-cli.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@eslint/js": "^10.0.1",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@playwright/test": "^1.63.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true,
    "fsevents": true
  }
}
